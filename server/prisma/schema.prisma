generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String          @id @default(cuid())
  email        String          @unique
  passwordHash String
  createdAt    DateTime        @default(now())
  quizResult   Json?
  // Unique slug used in ?ref=slug links. Generated server-side on
  // first /api/referrals/me hit so existing users get one lazily.
  referralCode String?         @unique
  // Who invited this user (nullable, only set on signups that arrived
  // via a ?ref=slug link).
  referredById String?
  referredBy   User?           @relation("Referrals", fields: [referredById], references: [id])
  referrals    User[]          @relation("Referrals")
  wishlist     WishlistItem[]
  wardrobe     WardrobeItem[]
  reviews      Review[]
  blends       SavedBlend[]
}

model Fragrance {
  id          Int             @id
  name        String
  brand       String
  type        String          // "niche" | "designer"
  family      String          // Fresh, Floral, Woody, Oriental, Gourmand
  top         String
  heart       String
  base        String
  season      String[]
  time        String[]
  mood        String[]
  description String?
  imageUrl    String?
  bg          String          // p-bg-1 ... p-bg-12 — preserves existing gradient class
  badge       String?
  createdAt   DateTime        @default(now())
  wishlist    WishlistItem[]
  wardrobe    WardrobeItem[]
  reviews     Review[]
}

model WishlistItem {
  id          String     @id @default(cuid())
  userId      String
  fragranceId Int
  createdAt   DateTime   @default(now())
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  fragrance   Fragrance  @relation(fields: [fragranceId], references: [id], onDelete: Cascade)

  @@unique([userId, fragranceId])
}

model WaitlistSignup {
  id        String   @id @default(cuid())
  email     String
  type      String   // "fotm" | "referral" | "general"
  createdAt DateTime @default(now())

  @@index([email, type])
}

// A user's Wardrobe captures their actual relationship to a fragrance:
// what they own (full bottle), what they have a sample of, and what
// they want a backup of. Reads as a per-user inventory rather than a
// passive saved list.
//   - OWNED   : they have a full bottle
//   - SAMPLED : they have a sample/decant
//   - BACKUP  : they own one but want a second bottle on standby
// (Wishlist remains the "considering" tier and lives in WishlistItem.)
model WardrobeItem {
  id          String     @id @default(cuid())
  userId      String
  fragranceId Int
  status      String     // "OWNED" | "SAMPLED" | "BACKUP"
  sizeMl      Int?       // For SAMPLED: which size they ordered
  notes       String?    // Free-text: how it wears on them
  createdAt   DateTime   @default(now())
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  fragrance   Fragrance  @relation(fields: [fragranceId], references: [id], onDelete: Cascade)

  @@unique([userId, fragranceId, status])
  @@index([userId, status])
}

// Customer reviews of fragrances they've sampled.
//   - LOVED    : would buy a full bottle
//   - LIKED    : nice but not a signature
//   - CONFLICT : the juice is fine but doesn't sit right on their skin
//   - HATED    : not for them
model Review {
  id          String     @id @default(cuid())
  userId      String
  fragranceId Int
  rating      String     // "LOVED" | "LIKED" | "CONFLICT" | "HATED"
  text        String?
  sizeMl      Int?       // Size they sampled
  createdAt   DateTime   @default(now())
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  fragrance   Fragrance  @relation(fields: [fragranceId], references: [id], onDelete: Cascade)

  @@unique([userId, fragranceId])
  @@index([fragranceId, createdAt])
}

// A blend the user composed in the Layer Builder and chose to save.
// `fragrances` is the input recipe (the scents the user combined).
// `result` is the full Anthropic layer_analysis response (blendName,
// tags, character, notes, occasions, tip). Stored verbatim so the
// "My Blends" tab can re-render the same card without another AI call.
model SavedBlend {
  id          String     @id @default(cuid())
  userId      String
  name        String     // user-editable; defaults to result.blendName
  fragrances  Json       // [{ id?, name, brand, family, top, heart, base }, ...]
  result      Json       // full layer_analysis tool response
  createdAt   DateTime   @default(now())
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// Layer suggestions, cached AI picks of 3 fragrances that layer well
// with a given source fragrance. One row per source fragrance id; the
// `partners` array stores [{id, name, brand, why}] and `result` stores
// the full Anthropic response. Regenerated only when the source
// fragrance changes meaningfully, otherwise reused across all visitors.
model LayerSuggestion {
  id          Int      @id @default(autoincrement())
  fragranceId Int      @unique
  partners    Json     // [{id, name, brand, why, match}]
  result      Json     // full AI response
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([fragranceId])
}

// Gift orders, separate model from Order because the user's intent
// and the rendering are meaningfully different. Sender pays via
// Stripe Checkout (same flow as a sample order), recipient receives
// a branded email pointing at /gift/:slug where they can read the
// editorial reveal page and trigger sample fulfillment via reply.
model GiftOrder {
  id              String   @id @default(cuid())
  // Public slug used in /gift/:slug, short + memorable, generated server-side.
  slug            String   @unique
  senderUserId    String?
  senderName      String
  senderEmail     String
  recipientName   String
  recipientEmail  String
  // Optional handwritten note from sender to recipient
  message         String?
  // The fragrance line items: same shape as Order.items
  items           Json
  amountTotal     Int
  currency        String   @default("usd")
  stripeSessionId String   @unique
  // Has the recipient opened the reveal page yet?
  openedAt        DateTime?
  // Has the recipient email been sent?
  emailedRecipient Boolean @default(false)
  createdAt       DateTime @default(now())

  @@index([recipientEmail, createdAt])
  @@index([senderEmail, createdAt])
}

// Orders, persisted record of every Stripe-completed purchase. The
// Stripe webhook hook in /api/payments writes one row per successful
// session. Used to drive lifecycle email triggers.
model Order {
  id              String   @id @default(cuid())
  userId          String?
  email           String
  stripeSessionId String   @unique
  amountTotal     Int      // cents
  currency        String   @default("usd")
  status          String   // 'paid' | 'fulfilled' | 'shipped'
  items           Json     // [{ fragranceId, name, brand, size, qty, unitPrice }]
  address         Json?
  // Lifecycle email flags so we never send the same email twice. The
  // cron job that runs the lifecycle scheduler flips these when each
  // email goes out.
  emailedConfirmation Boolean   @default(false)
  emailedShipped      Boolean   @default(false)
  emailedReviewPrompt Boolean   @default(false)
  emailedReorder      Boolean   @default(false)
  shippedAt           DateTime?
  createdAt           DateTime  @default(now())

  @@index([email, createdAt])
  @@index([emailedReviewPrompt, createdAt])
  @@index([emailedReorder, createdAt])
}

model SourceRequest {
  id        String   @id @default(cuid())
  name      String
  email     String
  fragrance String?
  message   String?
  kind      String   @default("sample") // "sample" | "bottle" | "cart"
  size      String?  // "2ml" | "5ml" | "10ml" | "30ml" for samples; free-text for bottles
  // For kind: "cart", `items` holds the line-item payload:
  //   [{ fragranceId, name, brand, size, qty }, ...]
  // For "sample" and "bottle" requests, items stays null (the top-level fields
  // already describe the single-item order).
  items     Json?
  address   String?  // Optional shipping line for cart orders
  createdAt DateTime @default(now())

  @@index([kind, createdAt])
}
