# Copy this to server/.env (and client/.env.local if you want to override defaults)
# Then run: npm install && npm run prisma:migrate && npm run seed && npm run dev

# ─── SERVER ────────────────────────────────────────────────────────────
# Postgres connection string. Local Docker: postgres://postgres:postgres@localhost:5432/scent_layer
# Railway provides this as DATABASE_URL automatically.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/scent_layer?schema=public"

# JWT signing secret. Use `openssl rand -base64 48` to generate one.
JWT_SECRET="change-me-in-production"

# Anthropic API key. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY="sk-ant-..."

# Sentry server-side error tracking. Optional — leave unset to disable.
# Get a DSN at https://sentry.io (free tier covers small projects easily).
SENTRY_DSN=""

# Resend API key for transactional email. Get one at https://resend.com
RESEND_API_KEY="re_..."
# The "from" address that source requests are sent FROM. Must be a verified domain on Resend
# (Resend won't let you send from @gmail.com — you'll need a domain you control, or you can use
# Resend's onboarding "Scent Layer <onboarding@resend.dev>" for the very first tests).
RESEND_FROM="Scent Layer <hello@yourdomain.com>"
# The email that sample orders and source requests are delivered TO (founder's inbox)
SOURCE_NOTIFY_EMAIL="scentlayer@gmail.com"

# CORS origin for the Vite frontend in dev. In prod, set to your Vercel URL.
CLIENT_ORIGIN="http://localhost:5173"

# Express port
PORT=4000

# ─── CLIENT ────────────────────────────────────────────────────────────
# Where the frontend looks for the API. Defaults to http://localhost:4000 in dev.
VITE_API_URL="http://localhost:4000"

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Optional — leave unset
# in local dev and analytics is disabled. The gtag script is only loaded
# AFTER the user grants consent via the cookie banner; without consent no
# GA cookies are set. Get a measurement ID at https://analytics.google.com
VITE_GA_MEASUREMENT_ID=""

# Sentry client-side error tracking. Optional — leave unset to disable.
# Get a DSN from the same Sentry project as SENTRY_DSN (or a separate one).
VITE_SENTRY_DSN=""
